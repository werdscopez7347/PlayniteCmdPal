# Build outputs
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
artifacts/

# Release tooling sources live under scripts/release even though [Rr]elease/ above
# ignores build-output directories with the same name.
!scripts/release/
!scripts/release/**
__pycache__/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / VS Code local state
.idea/
.vscode/

# MSBuild packaging output (AppxPackageDir default); never a release artifact
[Aa]ppPackages/

# Signing material. The PFX and its password stay outside the checkout (see docs/MSIX-SIGNING.md);
# these rules are a second line of defence so a stray key or exported certificate is never staged.
*.pfx
*.p12
*.cer
*.pvk

# NuGet
*.nupkg
.nuget/

# Local logs and environment
*.log
.env
.env.*
!.env.example

# Local Playnite data and test dumps
playnite-data/
local-library.json
